generator client {
  provider        = "prisma-client"
  output          = "../target/typedSql-pg"
  previewFeatures = ["typedSql"]
}

generator json {
  provider  = "node ./index.js"
  namespace = "PTypedSqlJson"
}

datasource db {
  provider = "postgresql"
}

model Model {
  id Int @id

  /// ![number]
  field Json

  /// [OptionalField]
  optField Json?

  /// ![{ tag: string }]
  tags Json[]

  /// !['model']
  shared Json
}

// Annotates `shared` differently than Model does, making the column ambiguous for any
// query that selects it without a `-- @pjt-type` annotation.
model Other {
  id Int @id

  /// !['other']
  shared Json
}
