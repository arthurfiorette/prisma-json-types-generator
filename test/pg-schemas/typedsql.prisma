generator client {
  provider        = "prisma-client"
  output          = "../target/typedSql-pg"
  previewFeatures = ["typedSql"]
}

generator json {
  provider  = "node ./index.js"
  namespace = "PTypedSqlJson"
}

datasource db {
  provider = "postgresql"
}

model Model {
  id Int @id

  /// ![number]
  field Json

  /// [OptionalField]
  optField Json?

  /// ![{ tag: string }]
  tags Json[]

  /// !['model']
  shared Json

  /// ![{ unit: string }]
  mapped Json @map("mapped_column")

  // An annotated non-Json field: nothing about the replacement is specific to Json
  /// [UserIdString]
  userId String

  // Annotated differently by Other, which makes it ambiguous
  /// !['from-model']
  slug String

  // No annotation at all
  plain String
}

// Annotates `shared` and `slug` differently than Model does, making both columns ambiguous
// for any query that selects them without a `-- @pjt-type` annotation.
model Other {
  id Int @id

  /// !['other']
  shared Json

  /// !['from-other']
  slug String
}
